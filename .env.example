# ==============================================================================
# Website Uptime + Keep-Alive Monitor - Environment Configuration
# ==============================================================================

# Shared PostgreSQL Database Connection
# Example for Render Postgres / Neon / Supabase:
# postgresql://postgres:your_secure_password@dpg-xxxxx-a.oregon-postgres.render.com:5432/monitor_db?sslmode=require
DATABASE_URL=postgresql://username:password@hostname:5432/dbname?sslmode=require

# Flask Dashboard Settings
SECRET_KEY=change-this-to-a-random-secret-key
PORT=5000
FLASK_ENV=production

# Monitoring Behavior Defaults
# Timeout in seconds for each website ping (Render cold starts can take 20-35s)
REQUEST_TIMEOUT=35

# Number of consecutive failed checks before a website status becomes OFFLINE
FAILURE_THRESHOLD=3

# Optional: Protect dashboard administrative actions (Add, Edit, Delete, Run Check)
# If left blank, the dashboard operates in open developer mode.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_admin_password
